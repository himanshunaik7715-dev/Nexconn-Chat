{
  "name": "nexconn-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --force",
    "start": "node server/index.js",
    "postinstall": "node scripts/patch-nexconn-chatui.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "audit:secrets": "node scripts/audit-secrets.js",
    "db:prepare-migration": "node scripts/prepare-db-migration.js",
    "db:import-migration": "node scripts/import-sqlite-to-postgres.js",
    "db:import-sqlite-to-postgres": "node scripts/import-sqlite-to-postgres.js"
  },
  "dependencies": {
    "@nexconn/chat": "26.2.0",
    "@nexconn/chatui": "26.2.0",
    "@nexconn/engine": "26.2.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lit": "^3.3.3",
    "lucide-react": "^0.456.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/node": "~18.14.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "typescript": "~5.4.0",
    "vite": "^6.4.6"
  }
}
